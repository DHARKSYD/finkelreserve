# Supabase project URL and publishable key. Use the same values for the
# server-side and Vite-prefixed variables.
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only key. Never add a VITE_ prefix to this value.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Use your deployed HTTPS origin in production. VITE_SITE_URL is embedded
# in the client bundle at build time.
SITE_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:3000

# Optional storefront contact link; digits only, including country code.
VITE_WHATSAPP_NUMBER=

# Optional online payments. Leave blank for pay-on-delivery only.
PAYSTACK_SECRET_KEY=

# Optional transactional email.
SENDGRID_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_FROM_NAME=Finkel Reserve
NOTIFY_REPLY_TO=

# SMS is disabled by default. Check DEPLOYMENT.md and README.md before enabling.
NOTIFY_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
